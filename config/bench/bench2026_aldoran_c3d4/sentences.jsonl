{"sentence_id": "bench2026_aldoran_c3d4:S0001", "seq": 1, "passage_id": "bench2026_aldoran_c3d4:0001", "page": 1, "section": "introduction", "subsection": null, "kind": "text", "source": "main", "text": "Bone loss is common in aged animals.", "start": 0, "end": 36, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0002", "seq": 2, "passage_id": "bench2026_aldoran_c3d4:0002", "page": 1, "section": "introduction", "subsection": null, "kind": "text", "source": "main", "text": "We examined whether the Aldoran peptide changes bone density in aged mice.", "start": 0, "end": 74, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0003", "seq": 3, "passage_id": "bench2026_aldoran_c3d4:0003", "page": 1, "section": "methods", "subsection": null, "kind": "text", "source": "main", "text": "Mice received the peptide or saline by daily injection for the whole study.", "start": 0, "end": 75, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0004", "seq": 4, "passage_id": "bench2026_aldoran_c3d4:0004", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Femur bone density was higher in peptide-treated mice (0.52 grams per cubic centimetre) than in saline-treated mice (0.44 grams per cubic centimetre).", "start": 0, "end": 150, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0005", "seq": 5, "passage_id": "bench2026_aldoran_c3d4:0005", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Serum calcium did not change with treatment (9.1 and 9.0 mg/dL).", "start": 0, "end": 64, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0006", "seq": 6, "passage_id": "bench2026_aldoran_c3d4:0006", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Bone formation markers appear to be higher in treated mice (41 versus 35 U/L).", "start": 0, "end": 78, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0007", "seq": 7, "passage_id": "bench2026_aldoran_c3d4:0007", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Treated mice may have had fewer fractures, with 2 fractures versus 5 in the saline group.", "start": 0, "end": 89, "citations": [], "mentions": []}
{"sentence_id": "bench2026_aldoran_c3d4:S0008", "seq": 8, "passage_id": "bench2026_aldoran_c3d4:0008", "page": 1, "section": "conclusion", "subsection": null, "kind": "text", "source": "main", "text": "The peptide was studied only in aged female mice and for a limited period.", "start": 0, "end": 74, "citations": [], "mentions": []}
