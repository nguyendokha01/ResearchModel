{"sentence_id": "bench2026_kelmorin_a1b2:S0001", "seq": 1, "passage_id": "bench2026_kelmorin_a1b2:0001", "page": 1, "section": "introduction", "subsection": null, "kind": "text", "source": "main", "text": "Cold storage of tissue is limited by progressive cell loss.", "start": 0, "end": 59, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0002", "seq": 2, "passage_id": "bench2026_kelmorin_a1b2:0002", "page": 1, "section": "introduction", "subsection": null, "kind": "text", "source": "main", "text": "We asked whether Kelmorin, a synthetic compound, protects rat kidney slices during cold storage.", "start": 0, "end": 96, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0003", "seq": 3, "passage_id": "bench2026_kelmorin_a1b2:0003", "page": 1, "section": "methods", "subsection": null, "kind": "text", "source": "main", "text": "Slices were kept in cold buffer for one day with or without Kelmorin.", "start": 0, "end": 69, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0004", "seq": 4, "passage_id": "bench2026_kelmorin_a1b2:0004", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Viability after storage was higher with Kelmorin (71%) than in untreated slices (52%).", "start": 0, "end": 86, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0005", "seq": 5, "passage_id": "bench2026_kelmorin_a1b2:0005", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Lactate release was lower in treated slices (3.1 mmol/L) than in untreated slices (4.8 mmol/L).", "start": 0, "end": 95, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0006", "seq": 6, "passage_id": "bench2026_kelmorin_a1b2:0006", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Tissue water content did not differ between the groups (78% and 79%).", "start": 0, "end": 69, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0007", "seq": 7, "passage_id": "bench2026_kelmorin_a1b2:0007", "page": 1, "section": "results", "subsection": null, "kind": "text", "source": "main", "text": "Caspase activity tended to be lower after Kelmorin treatment (1.9 versus 2.4 units), which may indicate reduced apoptosis.", "start": 0, "end": 122, "citations": [], "mentions": []}
{"sentence_id": "bench2026_kelmorin_a1b2:S0008", "seq": 8, "passage_id": "bench2026_kelmorin_a1b2:0008", "page": 1, "section": "conclusion", "subsection": null, "kind": "text", "source": "main", "text": "Kelmorin was tested only in rat kidney slices and not in whole organs.", "start": 0, "end": 70, "citations": [], "mentions": []}
